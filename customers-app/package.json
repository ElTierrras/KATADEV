{
  "name": "customers-app",
  "version": "1.0.0",
  "description": "Kata Junior Fullstack/Cloud - Ciclo de vida de una aplicacion (dev/qa/prod)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "cross-env APP_ENV=dev nodemon src/index.js",
    "qa": "cross-env APP_ENV=qa nodemon src/index.js",
    "prod": "cross-env APP_ENV=prod node src/index.js",
    "build": "node scripts/build.mjs",
    "start:dev": "cross-env APP_ENV=dev node dist/app.cjs",
    "start:qa": "cross-env APP_ENV=qa node dist/app.cjs",
    "start:prod": "cross-env APP_ENV=prod node dist/app.cjs",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --runInBand"
  },
  "keywords": [
    "kata",
    "cloud",
    "fullstack",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "esbuild": "^0.23.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
